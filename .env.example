DB_PASSWORD=change-me
JWT_SECRET=change-me-long-random
# Chưa có domain: SITE_ADDRESS=:80 và WEB_URL=http://<IP-VPS>. Có domain: SITE_ADDRESS=your-domain.com, WEB_URL=https://your-domain.com
SITE_ADDRESS=:80
WEB_URL=http://IP-VPS
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# VietQR (BIN ngân hàng: VCB=970436, MB=970422, ACB=970416, TCB=970407 ...)
BANK_BIN=970422
BANK_ACCOUNT=0123456789
BANK_ACCOUNT_NAME=NGUYEN VAN A
SEPAY_API_KEY=change-me
ALLOW_MOCK_PAY=false
# SMTP (tuỳ chọn)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TrueNote <no-reply@your-domain.com>
# Cloudflare R2 (lưu ảnh + ghi âm). Bucket cần bật public (r2.dev hoặc custom domain) → R2_PUBLIC_URL
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=heartpost
R2_PUBLIC_URL=https://files.your-domain.com
# Cổng publish trên host của Caddy (đổi nếu bị trùng)
HTTP_PORT=8088
HTTPS_PORT=8443
# Sao lưu DB hằng đêm lên R2 — dùng bucket RIÊNG TƯ (KHÔNG bật public), khác bucket ảnh. API token R2 phải có quyền Object Read & Write cho bucket này.
R2_BACKUP_BUCKET=heartpost-backups
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR=2
# Nên đặt để mã hoá bản sao lưu (mất passphrase = không khôi phục được; hãy cất giữ riêng):
BACKUP_PASSPHRASE=
# Email hiển thị ở chân thư thông báo gửi tới người nhận
SUPPORT_EMAIL=hello@your-domain.com
