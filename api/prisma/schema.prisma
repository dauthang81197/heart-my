generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LetterType {
  PRIVATE
  PUBLIC
  FUTURE
}

enum LetterStatus {
  DRAFT
  SCHEDULED
  SENT
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  avatar       String?
  passwordHash String?
  googleId     String?  @unique
  emailVerified Boolean @default(false)
  tokenVersion Int      @default(0) // tăng khi đổi/đặt lại mật khẩu hoặc xoá tài khoản → vô hiệu mọi JWT cũ
  deletedAt    DateTime?
  locale       String   @default("vi")
  role         String   @default("USER")
  createdAt    DateTime @default(now())
  letters      Letter[]
  stamps       UserStamp[]
  orders       Order[]
  authTokens   AuthToken[]
}

model Stamp {
  id        String   @id @default(cuid())
  name      String
  image     String // emoji hoặc url
  color     String   @default("#8aa4b5")
  price     Int // VND / tem
  active    Boolean  @default(true)
  owned     UserStamp[]
  letters   Letter[]
}

model UserStamp {
  id       String @id @default(cuid())
  userId   String
  stampId  String
  quantity Int    @default(0)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  stamp    Stamp  @relation(fields: [stampId], references: [id])

  @@unique([userId, stampId])
}

model Letter {
  id             String       @id @default(cuid())
  authorId       String
  type           LetterType
  status         LetterStatus @default(DRAFT)
  title          String       @default("")
  recipientName  String?
  recipientEmail String?
  deliverAt      DateTime?
  envelope       String       @default("classic")
  design         Json         @default("{}")
  stampId        String?
  shareToken     String       @unique @default(cuid())
  hidden         Boolean      @default(false) // bị gỡ do báo cáo / quản trị viên
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  stamp          Stamp?       @relation(fields: [stampId], references: [id])
  reports        Report[]
  viewCodes      ViewCode[]

  @@index([authorId])
  @@index([status, deliverAt])
}

model Order {
  id         String      @id @default(cuid())
  code       String      @unique // nội dung chuyển khoản, vd HP7K2X9A
  userId     String
  stampId    String
  quantity   Int
  amount     Int
  status     OrderStatus @default(PENDING)
  providerTx String?     @unique
  paidAt     DateTime?
  expiresAt  DateTime
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id])
}

/// Token dùng 1 lần cho xác minh email / đặt lại mật khẩu (lưu hash SHA-256).
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  type      String // VERIFY | RESET
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Report {
  id          String   @id @default(cuid())
  letterId    String
  reason      String // SPAM | ABUSE | ADULT | COPYRIGHT | OTHER
  note        String?
  reporterKey String // userId hoặc IP
  status      String   @default("OPEN") // OPEN | RESOLVED | DISMISSED
  createdAt   DateTime @default(now())
  letter      Letter   @relation(fields: [letterId], references: [id], onDelete: Cascade)

  @@unique([letterId, reporterKey])
  @@index([status])
}

/// Mã 6 số gửi tới email người nhận để mở thư riêng tư (lưu hash, hết hạn 10 phút).
model ViewCode {
  id        String   @id @default(cuid())
  letterId  String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  letter    Letter   @relation(fields: [letterId], references: [id], onDelete: Cascade)

  @@index([letterId])
}
